# ============================
# Unity - GitIgnore (Unified)
# Unity 6.2–6.7 + GitHub official
# ============================

# Crash Temp
.utmp/

# Unity Generated Folders
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/CrashReports/
/Artifacts/
/DerivedData/
/UnityCache/

# Blender
*.blend1
*.blend1.meta

# Burst Compiler Cache
[Bb]urstCache/

# Unity 6 Shader Cache
*.shadercache

# Visual Studio / IDE
.vs/
.idea/
*.DotSettings.user
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.opendb
*.pdb
*.mdb
*.pdb.meta
*.mdb.meta
*.pidb.meta
*.VC.db

# VSCode
.vscode/

# Asset Store Tools (optional)
# /[Aa]ssets/AssetStoreTools*

# Gradle
.gradle/

# Consulo legacy
.consulo/

# Test Runner auto scenes
InitTestScene*.unity*

# Unity Crash Reports
sysinfo.txt
mono_crash.*

# Generated by Unity Visual Scripting
/[Aa]ssets/Unity.VisualScripting.Generated/

# Addressables
/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Build Artifacts
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app
*.ipa
*.exe
*.xcodeproj
*.xcworkspace
*.xcuserstate
*.xcuserdatad

# Crashlytics
crashlytics-build.properties

# OS Specific
.DS_Store
Thumbs.db
desktop.ini

# JetBrains Rider
.idea/
*.iml

# Other Auto Generated
MemoryCaptures/
CrashReports/
ExportedObj/

# Ignore lock files
packages-lock.json

# PlasticSCM
.plastic/

# If you create your own build folder, ignore it:
Build*/
ExportedObj/

# Additional Unity 2023+ folders
/[Aa]rtifacts/
